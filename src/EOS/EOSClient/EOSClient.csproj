<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <AssemblyName>EOSClient.Reconstructed</AssemblyName>
    <RootNamespace />
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
    <ProjectReference Include="../IRemote/IRemote.csproj" />
    <Reference Include="NAudio">
      <HintPath>$(ExamInputsRoot)/EOS/NAudio.dll</HintPath>
    </Reference>
    <ProjectReference Include="../QuestionLib/QuestionLib.csproj" />
    <ProjectReference Include="../EncryptData/EncryptData.csproj" />
    <Compile Remove="-Module-.cs" />
    <EmbeddedResource Update="RulesForm.resx">
      <LogicalName>RulesForm.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
